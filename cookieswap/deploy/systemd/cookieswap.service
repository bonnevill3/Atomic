[Unit]
Description=cookieswap instant swap
Documentation=file:///opt/cookieswap/app/cookieswap/deploy/README.md
After=network-online.target monero-wallet-rpc.service
Wants=network-online.target

[Service]
Type=simple
User=cookieswap
Group=cookieswap
WorkingDirectory=/opt/cookieswap/app/cookieswap
EnvironmentFile=/etc/cookieswap/cookieswap.env
ExecStart=/opt/cookieswap/app/cookieswap/node_modules/.bin/tsx src/main.ts
Restart=always
RestartSec=5

# Sandbox: the service can read its code but only write its own data directory.
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/cookieswap
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
