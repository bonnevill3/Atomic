# --- mode -------------------------------------------------------------------------
# mock  = in-memory chains, simulated deposits (development)
# live  = real BTC / ETH / XMR hot wallets
CHAINS=mock
NETWORK=mainnet
# Nothing is broadcast while DRY_RUN=true (sends are logged with a fake txid).
DRY_RUN=true

HOST=127.0.0.1
PORT=8080
DB_PATH=./data/hypurswap.db
# >= 24 chars. Enables /admin (refunds, review, inventory). Required for live mainnet.
ADMIN_TOKEN=

# --- hot wallet keys (live only) ----------------------------------------------------
# File with a BIP39 mnemonic for the BTC + ETH (+ USDC/USDT) hot wallets (chmod 600, not in git).
# Keep some ETH on the ETH inventory address: it pays gas top-ups for stablecoin deposits.
MNEMONIC_FILE=./secrets/mnemonic.txt

# --- chain backends -----------------------------------------------------------------
BTC_ESPLORA_URL=https://blockstream.info/api
BTC_CONFIRMATIONS=2
ETH_RPC_URL=https://ethereum-rpc.publicnode.com
ETH_CONFIRMATIONS=12
# monero-wallet-rpc --disable-rpc-login, bound to localhost / private network only
XMR_WALLET_RPC_URL=http://127.0.0.1:18083/json_rpc
XMR_CONFIRMATIONS=10

# --- routes -------------------------------------------------------------------------
ENABLE_THORCHAIN=true
ENABLE_NEAR=true
ENABLE_INVENTORY=true
THORCHAIN_API_URL=https://gateway.liquify.com/chain/thorchain_api
NEAR_1CLICK_URL=https://1click.chaindefuser.com
NEAR_1CLICK_JWT=

# --- pricing & limits ---------------------------------------------------------------
SERVICE_FEE_BPS=50
INVENTORY_SPREAD_BPS=100
SLIPPAGE_BPS=100
MAX_RATE_DRIFT_BPS=200
MAX_ORACLE_DEVIATION_BPS=150
MIN_ORDER_USD=20
MAX_ORDER_USD=5000
# Safety net: orders worth more than this (USD, at deposit confirmation) wait for operator approval
MANUAL_REVIEW_USD=500
ORDER_TTL_MINUTES=60
# finished orders are hard-deleted after this many days
RETENTION_DAYS=7

# Optional: one address per line; matching recipients/refund addresses are refunded.
DENYLIST_FILE=
